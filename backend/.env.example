# Server
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data

# Provider keys. Empty key = provider disabled (falls back to mock).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Router. Provider names: openai | anthropic | gemini | grok | mock
COMMANDER_PROVIDER=anthropic
COMMANDER_MODEL=claude-sonnet-4
WORKER_PROVIDER=openai
WORKER_MODEL=gpt-4o
BROWSER_PROVIDER=gemini
BROWSER_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# The remote computer (GitHub Codespace)
# ---------------------------------------------------------------------------
# There is no VM any more. The agent in backend/vm_agent/daemon.py runs on the
# Codespace itself and serves the three apps -- browser, files, terminal.
# Set this only when the backend and the agent are on different machines; when
# they share one Codespace the default is already right.
WORKSPACE_BASE_URL=http://127.0.0.1:9000

# ---------------------------------------------------------------------------
# The live screen
# ---------------------------------------------------------------------------
# The passphrase for the whole app.  A Cloudflare Quick Tunnel puts this server on
# a public trycloudflare.com URL, and the Computer view is a live, signed-in,
# keyboard-driven Chrome -- so the tunnel URL cannot be the thing that protects
# it.  This value is.
#
# Leave it unset and the app refuses every route and every WebSocket.  That is
# the intended failure mode: a public tunnel in front of a real browser must
# never come up open by accident.
#
# Normally a Codespaces secret, not a committed file:
#   Settings > Codespaces > your codespace > Codespaces secrets
#     RAG_AUTH_TOKEN = <a long random passphrase>
# RAG_AUTH_TOKEN=change-me-to-a-long-random-passphrase

# Where the tunnel script records the hostname cloudflared handed it.  The
# Quick Tunnel picks a random origin on every restart, so the app reads it from
# here and hands it to the browser via /screen/config rather than hardcoding it.
# Keep it in sync with PUBLIC_URL_FILE in codespace/env.sh.
PUBLIC_URL_FILE=/tmp/ragdesktop/public-url

# x11vnc's RFB port and websockify's WebSocket port, both loopback-only.  The
# tunnel publishes neither: it publishes this app, and the app proxies
# /websockify to SCREEN_WS_PORT after checking the session cookie.
SCREEN_VNC_ENABLED=1
SCREEN_VNC_PORT=5900
SCREEN_WS_PORT=6080

# The Vite build to serve from this process, so the app and the screen are one
# origin.  Same host for the page and the WebSocket is what lets the session
# cookie ride along with the upgrade.  Leave empty to auto-detect
# ../Frontend/dist, and to fall back to the old bundled prototype if missing.
# FRONTEND_DIST=../Frontend/dist

# Tool limits
MAX_TEXT_CHARS=8000
MAX_WEB_CHARS=12000
MAX_ITERS=4
