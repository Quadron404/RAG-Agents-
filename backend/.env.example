# Server
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data

# Provider keys. Empty key = provider disabled (falls back to mock).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Router. Provider names: openai | anthropic | gemini | grok | mock
COMMANDER_PROVIDER=anthropic
COMMANDER_MODEL=claude-sonnet-4
WORKER_PROVIDER=openai
WORKER_MODEL=gpt-4o
BROWSER_PROVIDER=gemini
BROWSER_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# The remote computer (GitHub Codespace)
# ---------------------------------------------------------------------------
# There is no VM any more. The agent in backend/vm_agent/daemon.py runs on the
# Codespace itself and serves the three apps -- browser, files, terminal.
# Set this only when the backend and the agent are on different machines; when
# they share one Codespace the default is already right.
WORKSPACE_BASE_URL=http://127.0.0.1:9000

# ---------------------------------------------------------------------------
# The live screen
# ---------------------------------------------------------------------------
# Set the hostname and everything else follows: the viewer URL becomes
# wss://<hostname>/websockify, and the tunnel config uses the same host. This is
# normally a Codespaces secret, not something in this file.
# COMPUTER_HOSTNAME=computer.example.com

# Rarely needed. Override only if the screen really lives somewhere other than
# the app's own hostname -- remember the app and the screen should share a
# hostname so the Cloudflare Access cookie is first-party for both.
# COMPUTER_WS_URL=wss://screen.example.com/websockify

# x11vnc's RFB port and websockify's WebSocket port, both loopback-only.
SCREEN_VNC_ENABLED=1
SCREEN_VNC_PORT=5900
SCREEN_WS_PORT=6080

# The Vite build to serve from this process, so the app and the screen are one
# origin. Leave empty to auto-detect ../Frontend/dist, and to fall back to the
# old bundled prototype if that is missing.
# FRONTEND_DIST=../Frontend/dist

# Tool limits
MAX_TEXT_CHARS=8000
MAX_WEB_CHARS=12000
MAX_ITERS=4
