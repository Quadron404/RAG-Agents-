---
interface Props {}
---
<section id="upcoming-features" class="py-16 px-4 mobile:py-12 bg-background-secondary" aria-labelledby="upcoming-title">
  <div class="max-w-site mx-auto">
    <h2 id="upcoming-title" class="text-3xl font-semibold text-center mb-8 mobile:text-2xl">More coming in 2027</h2>

    <div class="flex flex-col items-center gap-6 max-w-2xl mx-auto text-center">
      <div class="w-full">
        <div class="aspect-video rounded-2xl bg-background-tertiary border border-border-primary flex items-center justify-center">
          <div class="text-center px-6">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 text-tertiary" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <h3 class="text-xl font-semibold mb-2">Personalized dashboard</h3>
            <p class="text-secondary mb-4">Your benefits, deadlines, and tasks in one place.</p>
            <a href="/coming-soon" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">See what's ahead →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>