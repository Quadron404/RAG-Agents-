---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelector from './LanguageSelector.astro';
---
<header class="site-header" data-chrome-tone="light">
  <div class="gov-banner" role="region" aria-label="U.S. Government Websites">
    <div class="mx-auto flex min-h-10 py-3 max-w-site items-center justify-center gap-2 page-gutter">
      <button
        type="button"
        class="gov-banner-button group flex cursor-pointer items-center gap-1.5 rounded-full focus-visible-ring"
        tabindex="0"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <span class="flex items-center gap-1">
          <span class="flex items-center pt-px">
            <span class="type-label-s flex h-2.5 items-end text-secondary transition-colors duration-200 group-hover-text-primary">
              An official website of the United States government
            </span>
          </span>
          <span class="flex size-4 shrink-0 items-center justify-center text-tertiary transition-colors duration-200 group-hover-text-primary">
            <svg fill="none" height="16" viewBox="0 0 20 20" width="16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M11 15H9V9H11V15Z" fill="currentColor" />
              <path d="M11.2 6.2C11.2 6.86 10.9 7.4 10 7.4C9.1 7.4 8.8 6.86 8.8 6.2C8.8 5.54 9.1 5 10 5C10.9 5 11.2 5.54 11.2 6.2Z" fill="currentColor" />
