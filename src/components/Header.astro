---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  currentTheme: 'light' | 'dark' | 'system';
  currentLanguage: 'en' | 'fr' | 'es';
}

const { currentTheme, currentLanguage } = Astro.props;
---
<header class="site-header fixed top-0 left-0 right-0 z-[var(--z-sticky)] bg-background-primary/80 backdrop-blur-md border-b border-border-primary" data-site-header>
  <div class="gov-banner bg-blue-50 dark:bg-blue-950/50 border-b border-border-primary">
    <div class="container flex min-h-[2.5rem] items-center justify-center gap-2">
      <button
        type="button"
        class="gov-banner-trigger flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium text-text-secondary hover:text-text-primary transition-colors focus-visible-ring"
        aria-expanded="false"
        aria-controls="gov-banner-panel"
        aria-label="U.S. Government Websites"
      >
        <svg class="w-4 h-4 flex-shrink-0 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>An official website of the United States government</span>
        <svg class="w-4 h-4 flex-shrink-0 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    <div id="gov-banner-panel" class="gov-banner-panel hidden container py-3" role="region" aria-label="U.S. Government Websites">
      <div class="flex flex-wrap items-center justify-center gap-2 text-sm text-text-secondary">
        <a href="https://www.usa.gov" target="_blank" rel="noopener noreferrer" class="hover:text-text-primary transition-colors">USA.gov</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.gsa.gov" target="_blank" rel="noopener noreferrer" class="hover:text-text-primary transition-colors">GSA.gov</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.whitehouse.gov" target="_blank" rel="noopener noreferrer" class="hover:text-text-primary transition-colors">WhiteHouse.gov</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.congress.gov" target="_blank" rel="noopener noreferrer" class="hover:text-text-primary transition-colors">Congress.gov</a>
      </div>
    </div>
  </div>

  <nav class="nav-main container" aria-label="Main navigation">
    <div class="flex h-[var(--header-height)] items-center justify-between gap-4">
      <a href="/" class="site-logo flex items-center gap-2 flex-shrink-0" aria-label="GovLink home">
        <svg class="w-8 h-8 text-accent-primary" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="currentColor"/>
          <path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="font-display font-semibold text-lg text-text-primary hidden sm:block">GovLink</span>
      </a>

      <div class="nav-actions flex items-center gap-2">
        <ThemeToggle currentTheme={currentTheme} />

        <LanguageSelector currentLanguage={currentLanguage} />

        <button
          type="button"
          class="btn btn-primary btn-md hidden sm:flex"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span>Menu</span>
        </button>

        <button
          type="button"
          class="btn btn-ghost btn-icon-lg sm:hidden"
          aria-label="Open menu"
          data-mobile-menu-trigger
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="mobile-menu hidden sm:hidden fixed inset-0 z-[var(--z-modal)] bg-background-overlay" data-mobile-menu-backdrop aria-hidden="true"></div>
  <aside class="mobile-menu fixed top-0 right-0 bottom-0 z-[var(--z-modal)] w-full max-w-sm bg-background-elevated shadow-2xl transform translate-x-full transition-transform duration-300 ease-out" data-mobile-menu-panel aria-label="Mobile menu">
    <div class="flex h-full flex-col">
      <div class="flex h-16 items-center justify-between border-b border-border-primary px-4">
        <span class="font-semibold text-text-primary">Menu</span>
        <button
          type="button"
          class="btn btn-ghost btn-icon"
          aria-label="Close menu"
          data-mobile-menu-close
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="flex-1 overflow-y-auto p-4 space-y-2" aria-label="Mobile navigation">
        <a href="/" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>Home</a>
        <a href="/chat" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>Chat</a>
        <a href="/how-it-works" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>How It Works</a>
        <a href="/about" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>About</a>
        <a href="/privacy-policy" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>Privacy Policy</a>
        <a href="/terms" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>Terms of Use</a>
        <a href="/faq" class="btn btn-secondary btn-lg w-full justify-start px-4" data-mobile-menu-link>FAQ</a>
        <div class="pt-4 border-t border-border-primary">
          <ThemeToggle currentTheme={currentTheme} />
          <LanguageSelector currentLanguage={currentLanguage} />
        </div>
      </nav>
    </div>
  </aside>
</header>

<script is:inline>
  // Gov banner toggle
  const bannerTrigger = document.querySelector('.gov-banner-trigger');
  const bannerPanel = document.querySelector('#gov-banner-panel');
  if (bannerTrigger && bannerPanel) {
    bannerTrigger.addEventListener('click', () => {
      const expanded = bannerTrigger.getAttribute('aria-expanded') === 'true';
      bannerTrigger.setAttribute('aria-expanded', (!expanded).toString());
      bannerPanel.classList.toggle('hidden');
      bannerTrigger.querySelector('svg:last-of-type').style.transform = expanded ? 'rotate(0deg)' : 'rotate(180deg)';
    });
  }

  // Mobile menu
  const mobileMenuTrigger = document.querySelector('[data-mobile-menu-trigger]');
  const mobileMenuBackdrop = document.querySelector('[data-mobile-menu-backdrop]');
  const mobileMenuPanel = document.querySelector('[data-mobile-menu-panel]');
  const mobileMenuClose = document.querySelector('[data-mobile-menu-close]');
  const mobileMenuLinks = document.querySelectorAll('[data-mobile-menu-link]');

  function openMobileMenu() {
    mobileMenuBackdrop.classList.remove('hidden');
    mobileMenuPanel.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
    mobileMenuTrigger?.setAttribute('aria-expanded', 'true');
  }

  function closeMobileMenu() {
    mobileMenuBackdrop.classList.add('hidden');
    mobileMenuPanel.classList.add('translate-x-full');
    document.body.style.overflow = '';
    mobileMenuTrigger?.setAttribute('aria-expanded', 'false');
  }

  mobileMenuTrigger?.addEventListener('click', openMobileMenu);
  mobileMenuBackdrop?.addEventListener('click', closeMobileMenu);
  mobileMenuClose?.addEventListener('click', closeMobileMenu);
  mobileMenuLinks.forEach(link => link.addEventListener('click', closeMobileMenu));

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenuPanel?.classList.contains('translate-x-full')) {
      closeMobileMenu();
    }
  });
</script>

<style>
  .gov-banner-trigger svg:last-of-type {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .gov-banner-panel {
    animation: slideDown var(--duration-normal) var(--ease-out);
  }

  .focus-visible-ring:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
</style>