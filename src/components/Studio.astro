---
interface Props {
  cards?: Array<{
    id: string;
    title: string;
    description: string;
    icon?: string;
  }>;
}
---
<script is:inline>
  const track = document.querySelector('.studio-carousel-track');
  const seats = document.querySelectorAll('.studio-portrait-seat');
  const prevBtn = document.querySelector('[data-carousel-prev]');
  const nextBtn = document.querySelector('[data-carousel-next]');
  const pauseBtn = document.querySelector('[data-carousel-pause]');
  const pauseIcon = document.querySelector('[data-pause-icon]');
  const playIcon = document.querySelector('[data-play-icon]');

  if (track && seats.length > 0) {
    let currentIndex = 0;
    const totalCards = seats.length;
    let autoRotateInterval;
    let isAnimating = false;
    let isPaused = false;

    function updateCarousel(index, instant = false) {
      if (isAnimating && !instant) return;
      isAnimating = !instant;

      seats.forEach((seat, i) => {
        const distance = (i - index + totalCards) % totalCards;
        const normalizedDistance = distance > totalCards / 2 ? distance - totalCards : distance;
        const absDistance = Math.abs(normalizedDistance);

        let scale = 1 - absDistance * 0.12;
        let opacity = 1 - absDistance * 0.25;
        let zIndex = totalCards - absDistance;
        let translateX = 0;

        if (absDistance > totalCards / 2) {
          opacity = 0;
          scale = 0.7;
        }

        if (normalizedDistance < 0) {
          translateX = -20 * absDistance;
        } else if (normalizedDistance > 0) {
          translateX = 20 * absDistance;
        }

        const transition = instant ? 'none' : 'transform 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 500ms cubic-bezier(0.22, 1, 0.36, 1), z-index 0ms, filter 500ms cubic-bezier(0.22, 1, 0.36, 1)';
        seat.style.transition = transition;
        seat.style.transform = `translateX(calc(-50% + ${translateX}px)) scale(${scale})`;
        seat.style.opacity = opacity.toString();
        seat.style.zIndex = zIndex.toString();
        seat.style.filter = absDistance === 0 ? 'none' : `blur(${absDistance * 1.5}px) grayscale(${absDistance * 30}%)`;

        const btn = seat.querySelector('button');
        if (btn) {
          btn.setAttribute('aria-current', (index === i).toString());
        }
      });

      setTimeout(() => { isAnimating = false; }, 500);
    }

    function nextCard() {
      currentIndex = (currentIndex + 1) % totalCards;
      updateCarousel(currentIndex);
    }

    function prevCard() {
      currentIndex = (currentIndex - 1 + totalCards) % totalCards;
      updateCarousel(currentIndex);
    }

    function startAutoRotate() {
      if (autoRotateInterval) clearInterval(autoRotateInterval);
      autoRotateInterval = window.setInterval(nextCard, 6000);
    }

    function stopAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
        autoRotateInterval = null;
      }
    }

    function togglePause() {
      isPaused = !isPaused;
      if (isPaused) {
        stopAutoRotate();
        pauseIcon?.classList.add('hidden');
        playIcon?.classList.remove('hidden');
        pauseBtn?.setAttribute('aria-label', 'Resume carousel');
      } else {
        startAutoRotate();
        pauseIcon?.classList.remove('hidden');
        playIcon?.classList.add('hidden');
        pauseBtn?.setAttribute('aria-label', 'Pause carousel');
      }
    }

    prevBtn?.addEventListener('click', () => {
      prevCard();
      stopAutoRotate();
      if (!isPaused) startAutoRotate();
    });

    nextBtn?.addEventListener('click', () => {
      nextCard();
      stopAutoRotate();
      if (!isPaused) startAutoRotate();
    });

    pauseBtn?.addEventListener('click', togglePause);

    seats.forEach((seat, index) => {
      seat.addEventListener('click', () => {
        if (index !== currentIndex) {
          currentIndex = index;
          updateCarousel(currentIndex);
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        }
      });

      seat.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (index !== currentIndex) {
            currentIndex = index;
            updateCarousel(currentIndex);
            stopAutoRotate();
            if (!isPaused) startAutoRotate();
          }
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextCard();
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          prevCard();
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        }
      });

      seat.setAttribute('tabindex', '0');
      seat.setAttribute('role', 'button');
      seat.setAttribute('aria-label', `View ${seats.length > index ? seats[index].querySelector('.studio-portrait-title')?.textContent || `card ${index + 1}` : `card ${index + 1}`}`);
      seat.setAttribute('aria-current', (index === 0).toString());
    });

    // Pause on hover/focus
    const carousel = document.querySelector('.studio-carousel');
    carousel?.addEventListener('mouseenter', () => {
      if (!isPaused) stopAutoRotate();
    });
    carousel?.addEventListener('mouseleave', () => {
      if (!isPaused) startAutoRotate();
    });
    carousel?.addEventListener('focusin', () => {
      if (!isPaused) stopAutoRotate();
    });
    carousel?.addEventListener('focusout', () => {
      if (!isPaused) startAutoRotate();
    });

    // Keyboard navigation for carousel container
    carousel?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextCard();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevCard();
      } else if (e.key === ' ') {
        e.preventDefault();
        togglePause();
      }
    });

    updateCarousel(0, true);
    startAutoRotate();
  }
</script>

<section class="studio-section py-16 lg:py-24 relative" aria-labelledby="studio-title">
  <div class="container">
    <header class="text-center mb-12 lg:mb-16">
      <h2 id="studio-title" class="text-3xl lg:text-4xl font-display font-semibold text-text-primary mb-4 animate-fade-in stagger-1">
        Government services at a glance
      </h2>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto animate-fade-in stagger-2">
        Explore key federal programs and services. Each card represents a gateway to official government resources.
      </p>
    </header>

    <div class="studio-carousel relative" role="region" aria-label="Government service cards" aria-roledescription="carousel">
      <div class="studio-carousel-track flex items-center justify-center gap-4 lg:gap-6 pb-8 lg:pb-12" role="list">
        {(
          Astro.props.cards || [
            { id: 'medicare', title: 'Medicare', description: 'Health coverage for people 65+', icon: '🏥' },
            { id: 'social-security', title: 'Social Security', description: 'Retirement, disability, and survivors benefits', icon: '💰' },
            { id: 'veteran-care', title: 'Veteran Care', description: 'Health care and benefits for veterans', icon: '🎖️' },
            { id: 'passport', title: 'Passports', description: 'Apply for or renew your US passport', icon: '📘' },
            { id: 'national-park', title: 'National Parks', description: 'Explore America\'s national parks', icon: '🏞️' },
            { id: 'new-job', title: 'New Job', description: 'Resources for job seekers', icon: '💼' },
            { id: 'taxes', title: 'Taxes', description: 'File taxes and get refund info', icon: '📊' },
            { id: 'student-aid', title: 'Student Aid', description: 'FAFSA and federal student loans', icon: '🎓' },
            { id: 'small-business', title: 'Small Business', description: 'SBA loans and resources', icon: '🏪' },
            { id: 'immigration', title: 'Immigration', description: 'Citizenship and visa services', icon: '🌍' },
            { id: 'disaster-relief', title: 'Disaster Relief', description: 'FEMA assistance and recovery', icon: '🆘' },
            { id: 'housing', title: 'Housing', description: 'HUD programs and fair housing', icon: '🏠' }
          ]
        ).map((card, index) => (
          <article class="studio-portrait-seat group" role="listitem" style={index === 0 ? 'opacity: 1; transform: translateX(-50%) scale(1); z-index: 10;' : 'opacity: 0.4; transform: translateX(-50%) scale(0.88); z-index: 1; filter: blur(1.5px) grayscale(30%);'}>
            <button class="studio-portrait w-full aspect-square rounded-2xl bg-gradient-to-br from-blue-50 to-emerald-50 dark:from-blue-900/30 dark:to-emerald-900/30 border border-border-primary/50 overflow-hidden shadow-lg hover:shadow-xl transition-all duration-500 ease-out relative" aria-label={`View ${card.title}`}>
              <div class="absolute inset-0 bg-gradient-to-br from-accent-primary/5 to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
              <div class="relative z-10 p-6 lg:p-8 flex flex-col items-center justify-center h-full">
                <div class="studio-icon w-16 h-16 lg:w-20 lg:h-20 rounded-xl bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm flex items-center justify-center shadow-lg mb-4 lg:mb-6 transition-transform duration-500 group-hover:scale-110" aria-hidden="true">
                  <span class="text-3xl lg:text-4xl">{card.icon}</span>
                </div>
                <h3 class="studio-portrait-title text-lg lg:text-xl font-display font-semibold text-text-primary text-center mb-2 lg:mb-3">{card.title}</h3>
                <p class="text-sm lg:text-base text-text-secondary text-center leading-relaxed px-2">{card.description}</p>
              </div>
              <div class="studio-glow absolute inset-0 bg-gradient-to-t from-accent-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl pointer-events-none" aria-hidden="true"></div>
            </button>
          </article>
        ))}
      </div>

      <div class="carousel-controls flex items-center justify-center gap-4 mt-8 animate-fade-in stagger-3">
        <button
          data-carousel-prev
          type="button"
          class="btn btn-secondary btn-icon p-2 lg:p-3 rounded-full"
          aria-label="Previous card"
        >
          <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="carousel-indicators flex items-center gap-1.5" aria-hidden="true">
          {(
            Astro.props.cards || [
              { id: 'medicare' }, { id: 'social-security' }, { id: 'veteran-care' },
              { id: 'passport' }, { id: 'national-park' }, { id: 'new-job' },
              { id: 'taxes' }, { id: 'student-aid' }, { id: 'small-business' },
              { id: 'immigration' }, { id: 'disaster-relief' }, { id: 'housing' }
            ]
          ).map((_, index) => (
            <button
              class="carousel-indicator w-2 h-2 lg:w-2.5 lg:h-2.5 rounded-full transition-all duration-300 ease-out bg-border-primary"
              data-carousel-indicator={index}
              aria-label={`Go to card ${index + 1}`}
              style={index === 0 ? 'background-color: var(--color-accent-primary); width: 24px; border-radius: var(--radius-full);' : ''}
            ></button>
          ))}
        </div>

        <button
          data-carousel-next
          type="button"
          class="btn btn-secondary btn-icon p-2 lg:p-3 rounded-full"
          aria-label="Next card"
        >
          <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <button
          data-carousel-pause
          type="button"
          class="btn btn-ghost btn-icon p-2 lg:p-3 rounded-full"
          aria-label="Pause carousel"
        >
          <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" data-pause-icon>
            <rect x="6" y="4" width="4" height="16" rx="1" />
            <rect x="14" y="4" width="4" height="16" rx="1" />
          </svg>
          <svg class="w-5 h-5 lg:w-6 lg:h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" data-play-icon>
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Indicator click handlers
  document.querySelectorAll('[data-carousel-indicator]').forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      const carousel = indicator.closest('.studio-carousel');
      if (carousel) {
        // We need to trigger the carousel update
        const track = carousel.querySelector('.studio-carousel-track');
        const seats = carousel.querySelectorAll('.studio-portrait-seat');
        if (track && seats.length > 0) {
          // Dispatch a custom event that the main carousel script can listen to
          carousel.dispatchEvent(new CustomEvent('carousel-navigate', { detail: { index } }));
        }
      }
    });
  });

  // Listen for navigation events
  document.querySelectorAll('.studio-carousel').forEach(carousel => {
    carousel.addEventListener('carousel-navigate', (e) => {
      const seats = carousel.querySelectorAll('.studio-portrait-seat');
      const indicators = carousel.querySelectorAll('[data-carousel-indicator]');
      const index = e.detail.index;

      if (index >= 0 && index < seats.length) {
        // Update indicators
        indicators.forEach((ind, i) => {
          if (i === index) {
            ind.style.backgroundColor = 'var(--color-accent-primary)';
            ind.style.width = '24px';
            ind.style.borderRadius = 'var(--radius-full)';
          } else {
            ind.style.backgroundColor = 'var(--color-border-primary)';
            ind.style.width = '';
            ind.style.borderRadius = '';
          }
        });

        // Update carousel (the main script handles this via global state)
        // We'll just click the seat to trigger the existing logic
        seats[index]?.click();
      }
    });
  });
</script>

<style>
  .studio-portrait-seat {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 500ms cubic-bezier(0.22, 1, 0.36, 1), filter 500ms cubic-bezier(0.22, 1, 0.36, 1), z-index 0ms;
  }

  .studio-portrait-seat:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 4px;
  }

  .studio-portrait {
    will-change: transform, box-shadow;
  }

  .studio-portrait:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 4px;
  }

  .carousel-indicator {
    cursor: pointer;
  }

  .carousel-indicator:hover {
    transform: scale(1.2);
  }

  .carousel-indicator:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-portrait-seat,
    .studio-portrait,
    .carousel-indicator {
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .studio-carousel-track {
      padding-bottom: var(--space-6);
    }

    .studio-portrait-seat {
      min-width: 280px;
    }

    .carousel-controls {
      flex-wrap: wrap;
    }

    .carousel-indicators {
      order: -1;
      width: 100%;
      justify-content: center;
      margin-bottom: var(--space-4);
    }
  }
</style>