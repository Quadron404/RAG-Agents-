<script is:inline>
  const track = document.querySelector('.studio-carousel-track');
  const seats = document.querySelectorAll('.studio-portrait-seat');
  const prevBtn = document.querySelector('[data-carousel-prev]');
  const nextBtn = document.querySelector('[data-carousel-next]');
  const pauseBtn = document.querySelector('[data-carousel-pause]');
  const pauseIcon = document.querySelector('[data-pause-icon]');
  const playIcon = document.querySelector('[data-play-icon]');
  const indicators = document.querySelectorAll('[data-carousel-indicator]');

  if (track && seats.length > 0) {
    let currentIndex = 0;
    const totalCards = seats.length;
    let autoRotateInterval;
    let isAnimating = false;
    let isPaused = false;

    function updateCarousel(index, instant = false) {
      if (isAnimating && !instant) return;
      isAnimating = !instant;

      seats.forEach((seat, i) => {
        const distance = (i - index + totalCards) % totalCards;
        const normalizedDistance = distance > totalCards / 2 ? distance - totalCards : distance;
        const absDistance = Math.abs(normalizedDistance);

        let scale = 1 - absDistance * 0.12;
        let opacity = 1 - absDistance * 0.25;
        let zIndex = totalCards - absDistance;
        let translateX = 0;

        if (absDistance > totalCards / 2) {
          opacity = 0;
          scale = 0.7;
        }

        if (normalizedDistance < 0) {
          translateX = -20 * absDistance;
        } else if (normalizedDistance > 0) {
          translateX = 20 * absDistance;
        }

        const transition = instant ? 'none' : 'transform 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 500ms cubic-bezier(0.22, 1, 0.36, 1), z-index 0ms, filter 500ms cubic-bezier(0.22, 1, 0.36, 1)';
        seat.style.transition = transition;
        seat.style.transform = `translateX(calc(-50% + ${translateX}px)) scale(${scale})`;
        seat.style.opacity = opacity.toString();
        seat.style.zIndex = zIndex.toString();
        seat.style.filter = absDistance === 0 ? 'none' : `blur(${absDistance * 1.5}px) grayscale(${absDistance * 30}%)`;

        const btn = seat.querySelector('button');
        if (btn) {
          btn.setAttribute('aria-current', (index === i).toString());
        }
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.style.backgroundColor = 'var(--color-primary)';
          indicator.style.width = '24px';
          indicator.style.borderRadius = 'var(--radius-full)';
        } else {
          indicator.style.backgroundColor = 'var(--color-border-primary)';
          indicator.style.width = '';
          indicator.style.borderRadius = '';
        }
      });

      setTimeout(() => { isAnimating = false; }, 500);
    }

    function nextCard() {
      currentIndex = (currentIndex + 1) % totalCards;
      updateCarousel(currentIndex);
    }

    function prevCard() {
      currentIndex = (currentIndex - 1 + totalCards) % totalCards;
      updateCarousel(currentIndex);
    }

    function startAutoRotate() {
      if (autoRotateInterval) clearInterval(autoRotateInterval);
      autoRotateInterval = window.setInterval(nextCard, 6000);
    }

    function stopAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
        autoRotateInterval = null;
      }
    }

    function togglePause() {
      isPaused = !isPaused;
      if (isPaused) {
        stopAutoRotate();
        pauseIcon?.classList.add('hidden');
        playIcon?.classList.remove('hidden');
        pauseBtn?.setAttribute('aria-label', 'Resume carousel');
      } else {
        startAutoRotate();
        pauseIcon?.classList.remove('hidden');
        playIcon?.classList.add('hidden');
        pauseBtn?.setAttribute('aria-label', 'Pause carousel');
      }
    }

    prevBtn?.addEventListener('click', () => {
      prevCard();
      stopAutoRotate();
      if (!isPaused) startAutoRotate();
    });

    nextBtn?.addEventListener('click', () => {
      nextCard();
      stopAutoRotate();
      if (!isPaused) startAutoRotate();
    });

    pauseBtn?.addEventListener('click', togglePause);

    seats.forEach((seat, index) => {
      seat.addEventListener('click', () => {
        if (index !== currentIndex) {
          currentIndex = index;
          updateCarousel(currentIndex);
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        }
      });

      seat.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (index !== currentIndex) {
            currentIndex = index;
            updateCarousel(currentIndex);
            stopAutoRotate();
            if (!isPaused) startAutoRotate();
          }
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextCard();
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          prevCard();
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        }
      });

      seat.setAttribute('tabindex', '0');
      seat.setAttribute('role', 'button');
      seat.setAttribute('aria-label', `View card ${index + 1}`);
      seat.setAttribute('aria-current', (index === 0).toString());
    });

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        if (index !== currentIndex) {
          currentIndex = index;
          updateCarousel(currentIndex);
          stopAutoRotate();
          if (!isPaused) startAutoRotate();
        }
      });

      indicator.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (index !== currentIndex) {
            currentIndex = index;
            updateCarousel(currentIndex);
            stopAutoRotate();
            if (!isPaused) startAutoRotate();
          }
        }
      });

      indicator.setAttribute('tabindex', '0');
      indicator.setAttribute('role', 'button');
      indicator.setAttribute('aria-label', `Go to card ${index + 1}`);
    });

    const carousel = document.querySelector('.studio-carousel');
    carousel?.addEventListener('mouseenter', () => {
      if (!isPaused) stopAutoRotate();
    });
    carousel?.addEventListener('mouseleave', () => {
      if (!isPaused) startAutoRotate();
    });
    carousel?.addEventListener('focusin', () => {
      if (!isPaused) stopAutoRotate();
    });
    carousel?.addEventListener('focusout', () => {
      if (!isPaused) startAutoRotate();
    });

    carousel?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextCard();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevCard();
      } else if (e.key === ' ') {
        e.preventDefault();
        togglePause();
      }
    });

    updateCarousel(0, true);
    startAutoRotate();
  }
</script>

