---
interface Props {
  isChatPage?: boolean;
}
---
<script is:inline>
  const form = document.querySelector('[data-chat-form]');
  const textarea = document.querySelector('[data-chat-input]');
  const sendButton = document.querySelector('[data-chat-send]');
  const dropZone = document.querySelector('[data-drop-zone]');
  const fileInput = document.querySelector('[data-file-input]');
  const uploadButton = document.querySelector('[data-upload-button]');
  const voiceButton = document.querySelector('[data-voice-button]');
  const filePreviews = document.querySelector('[data-file-previews]');
  const charCount = document.querySelector('[data-char-count]');

  if (form && textarea && sendButton) {
    const MAX_CHARS = 4000;
    const MAX_FILES = 5;
    const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB
    const ACCEPTED_TYPES = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'text/plain', 'image/png', 'image/jpeg', 'image/gif', 'image/webp'];
    const uploadedFiles = new Map();

    function updateSendButton() {
      const hasContent = textarea.value.trim().length > 0 || uploadedFiles.size > 0;
      sendButton.disabled = !hasContent;
      sendButton.setAttribute('aria-disabled', (!hasContent).toString());
    }

    function autoResize() {
      textarea.style.height = 'auto';
      const newHeight = Math.min(textarea.scrollHeight, 200);
      textarea.style.height = newHeight + 'px';
    }

    function updateCharCount() {
      const length = textarea.value.length;
      if (charCount) {
        charCount.textContent = `${length}/${MAX_CHARS}`;
        charCount.style.color = length > MAX_CHARS * 0.9 ? 'var(--color-accent-destructive)' : 'var(--color-text-tertiary)';
      }
    }

    function createFilePreview(file, id) {
      const preview = document.createElement('div');
      preview.className = 'file-preview flex items-center gap-2 px-3 py-2 bg-background-tertiary rounded-xl';
      preview.dataset.fileId = id;

      const icon = getFileIcon(file.type);
      const size = formatFileSize(file.size);

      preview.innerHTML = `
        <span class="file-icon flex-shrink-0">${icon}</span>
        <div class="file-info flex-1 min-w-0">
          <span class="file-name block text-sm font-medium text-text-primary truncate">${escapeHtml(file.name)}</span>
          <span class="file-size text-xs text-text-tertiary">${size}</span>
        </div>
        <button type="button" class="file-remove btn btn-ghost btn-icon p-1 text-text-tertiary hover:text-accent-destructive" aria-label="Remove ${escapeHtml(file.name)}">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      `;

      preview.querySelector('.file-remove').addEventListener('click', () => {
        uploadedFiles.delete(id);
        preview.remove();
        updateSendButton();
        updateFileInput();
      });

      return preview;
    }

    function getFileIcon(mimeType) {
      if (mimeType.startsWith('image/')) {
        return `<svg class="w-5 h-5 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`;
      }
      if (mimeType === 'application/pdf') {
        return `<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`;
      }
      if (mimeType.includes('word')) {
        return `<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`;
      }
      return `<svg class="w-5 h-5 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>`;
    }

    function formatFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function updateFileInput() {
      const dt = new DataTransfer();
      uploadedFiles.forEach(file => dt.items.add(file));
      fileInput.files = dt.files;
    }

    function handleFiles(files) {
      Array.from(files).forEach(file => {
        if (!ACCEPTED_TYPES.includes(file.type)) {
          showToast('File type not supported. Please upload PDF, DOC, DOCX, TXT, PNG, JPG, GIF, or WEBP.', 'error');
          return;
        }
        if (file.size > MAX_FILE_SIZE) {
          showToast(`File too large. Maximum size is ${formatFileSize(MAX_FILE_SIZE)}.`, 'error');
          return;
        }
        if (uploadedFiles.size >= MAX_FILES) {
          showToast(`Maximum ${MAX_FILES} files allowed.`, 'error');
          return;
        }

        const id = `${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
        uploadedFiles.set(id, file);
        const preview = createFilePreview(file, id);
        filePreviews?.appendChild(preview);
      });
      updateFileInput();
      updateSendButton();
    }

    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      toast.className = `toast fixed bottom-4 right-4 z-[var(--z-toast)] px-4 py-3 rounded-xl shadow-xl animate-slide-up ${type === 'error' ? 'bg-accent-destructive text-white' : 'bg-background-elevated border border-border-primary'}`;
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.style.animation = 'fadeOut 0.3s ease-out forwards';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    textarea.addEventListener('input', () => {
      updateSendButton();
      autoResize();
      updateCharCount();
    });

    textarea.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
        e.preventDefault();
        if (textarea.value.trim() || uploadedFiles.size > 0) {
          form.dispatchEvent(new Event('submit'));
        }
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = textarea.value.trim();
      if (!message && uploadedFiles.size === 0) return;

      const payload = {
        message,
        files: Array.from(uploadedFiles.values()).map(f => ({ name: f.name, type: f.type, size: f.size }))
      };

      console.log('Sending message:', payload);

      textarea.value = '';
      uploadedFiles.clear();
      filePreviews?.replaceChildren();
      autoResize();
      updateSendButton();
      updateCharCount();
      updateFileInput();
    });

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      dropZone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
      }, false);
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone?.addEventListener(eventName, () => {
        dropZone.classList.add('active');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone?.addEventListener(eventName, () => {
        dropZone.classList.remove('active');
      }, false);
    });

    dropZone?.addEventListener('drop', (e) => {
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) {
        handleFiles(files);
      }
    }, false);

    uploadButton?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', (e) => {
      const target = e.target;
      if (target.files && target.files.length > 0) {
        handleFiles(target.files);
      }
    });

    voiceButton?.addEventListener('click', () => {
      if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognition = new SpeechRecognition();
        recognition.lang = 'en-US';
        recognition.interimResults = true;
        recognition.maxAlternatives = 1;

        let finalTranscript = '';

        recognition.onstart = () => {
          voiceButton.classList.add('listening');
          voiceButton.setAttribute('aria-label', 'Stop voice input');
          voiceButton.innerHTML = `
            <svg class="w-5 h-5 animate-pulse" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c.3 0 .54.24.54.54v3.18c-.94.05-1.73.65-2.19 1.55-.2.38-.2.88 0 1.26.2.39.59.66 1.03.82.04-.34.07-.69.07-1.04V11.5c0-.55-.45-1-1-1h-.76v1.77c0 .22-.12.42-.3.53L15.6 18.33a.996.996 0 01-1.2 0L8.3 15.17a.996.996 0 010-1.41l1.59-1.59c-.34-.19-.5-.52-.5-.89V11.5c0-.3.03-.59.07-.86 0 0 .01-.01.01-.02.44-.17.84-.43 1.09-.83.46-.9 1.25-1.5 2.19-1.55V11.5c0-.3.24-.54.54-.54h.01c3.87 0 7 3.13 7 7s-3.13 7-7 7c-1.3 0-2.47-.5-3.33-1.31V21h3v-3.04c2.13.44 4.23-.43 5.12-2l-1.62-1.62z"/>
            </svg>
          `;
        };

        recognition.onresult = (event) => {
          let interimTranscript = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              finalTranscript += event.results[i][0].transcript;
            } else {
              interimTranscript += event.results[i][0].transcript;
            }
          }
          textarea.value = finalTranscript + interimTranscript;
          textarea.dispatchEvent(new Event('input'));
        };

        recognition.onerror = (event) => {
          console.error('Speech recognition error:', event.error);
          if (event.error !== 'no-speech') {
            showToast('Voice input error. Please try again.', 'error');
          }
          voiceButton.classList.remove('listening');
          voiceButton.setAttribute('aria-label', 'Voice input');
          resetVoiceButton();
        };

        recognition.onend = () => {
          voiceButton.classList.remove('listening');
          voiceButton.setAttribute('aria-label', 'Voice input');
          resetVoiceButton();
        };

        function resetVoiceButton() {
          voiceButton.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 10v2a7 7 0 01-14 0v-2" />
              <line stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="12" y1="19" x2="12" y2="22" />
            </svg>
          `;
        }

        if (voiceButton.classList.contains('listening')) {
          recognition.stop();
        } else {
          recognition.start();
        }
      } else {
        showToast('Voice input is not supported in this browser.', 'error');
      }
    });

    updateSendButton();
    autoResize();
    updateCharCount();

    // Add fadeOut animation
    const style = document.createElement('style');
    style.textContent = `
      @keyframes fadeOut {
        from { opacity: 1; transform: translateY(0); }
        to { opacity: 0; transform: translateY(10px); }
      }
    `;
    document.head.appendChild(style);
  }
</script>

<section class="hero-section relative min-h-[calc(100dvh-var(--header-height))] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-16 lg:py-24 overflow-hidden" data-hero>
  <div class="hero-gradient rounded-3xl lg:rounded-4xl" aria-hidden="true"></div>

  <div class="noise-bg" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-4xl">
    <div class="text-center mb-10 lg:mb-14 animate-fade-in stagger-1">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-primary/10 text-accent-primary text-xs font-medium mb-6 animate-fade-in stagger-2">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>Search across 29,000+ government websites</span>
      </span>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-semibold text-text-primary leading-tight mb-6 animate-slide-up stagger-3 text-balance">
        Hello,<br>
        <span class="gradient-text">America</span>
      </h1>

      <p class="text-lg sm:text-xl lg:text-2xl text-text-secondary max-w-2xl mx-auto leading-relaxed animate-slide-up stagger-4 text-balance">
        Whatever you need from government, start here. Clear answers from official sources.
      </p>
    </div>

    <div class="animate-slide-up stagger-5" data-chat-container>
      <div class="chat-shell glass rounded-2xl lg:rounded-3xl border border-border-primary/50 overflow-hidden shadow-xl">
        <div class="chat-header px-4 py-3 border-b border-border-primary/50 bg-background-primary/50">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <span class="text-sm font-medium text-text-secondary">GovLink Assistant</span>
              <span class="w-2 h-2 rounded-full bg-emerald-500" aria-label="Online"></span>
            </div>
            <div class="flex items-center gap-1">
              <button class="btn btn-ghost btn-icon p-1" aria-label="New chat">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </button>
              <button class="btn btn-ghost btn-icon p-1" aria-label="Settings">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="chat-messages p-4 space-y-4 max-h-[400px] overflow-y-auto scrollbar-thin" data-messages>
          <div class="message assistant flex gap-3 animate-fade-in">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-sm text-text-secondary">Hello! I can help you find answers from official government sources. Try asking about benefits, passports, taxes, veterans' services, or any government program.</p>
            </div>
          </div>
          <div class="message assistant flex gap-3 animate-fade-in stagger-2">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="example-chips flex flex-wrap gap-2">
                <button class="example-chip btn btn-ghost btn-sm px-3 py-1.5" data-example="How do I replace my Social Security card?">How do I replace my Social Security card?</button>
                <button class="example-chip btn btn-ghost btn-sm px-3 py-1.5" data-example="I'm a veteran. How do I get care?">I'm a veteran. How do I get care?</button>
                <button class="example-chip btn btn-ghost btn-sm px-3 py-1.5" data-example="What are the requirements for a passport?">What are the requirements for a passport?</button>
                <button class="example-chip btn btn-ghost btn-sm px-3 py-1.5" data-example="How do I apply for Medicare?">How do I apply for Medicare?</button>
              </div>
            </div>
          </div>
        </div>

        <form data-chat-form class="chat-input-area p-4 border-t border-border-primary/50 bg-background-primary/50" aria-label="Describe what you need">
          <div class="flex flex-col gap-3">
            <div id="file-previews" data-file-previews class="flex flex-wrap gap-2 min-h-[2rem]"></div>

            <div class="relative" data-chat-input-row>
              <div class="relative flex-1">
                <textarea
                  data-chat-input
                  id="chat-input"
                  class="input w-full min-h-[60px] max-h-[160px] resize-none pr-16 bg-transparent border-border-primary/50 focus:border-accent-primary focus:ring-0 placeholder:text-text-tertiary"
                  placeholder="Ask about benefits, passports, taxes, veterans' services..."
                  aria-describedby="chat-hint"
                  spellcheck="false"
                  maxlength="4000"
                ></textarea>
                <div class="absolute bottom-2 right-2 flex items-center gap-2 pointer-events-none">
                  <span id="chat-char-count" data-char-count class="text-xs text-text-tertiary pointer-events-auto">0/4000</span>
                </div>
              </div>

              <div class="chat-actions flex items-center gap-1.5">
                <button
                  data-upload-button
                  type="button"
                  class="btn btn-ghost btn-icon p-1.5 text-text-tertiary hover:text-text-primary hover:bg-background-tertiary"
                  aria-label="Attach files"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                  </svg>
                </button>

                <button
                  data-voice-button
                  type="button"
                  class="btn btn-ghost btn-icon p-1.5 text-text-tertiary hover:text-text-primary hover:bg-background-tertiary"
                  aria-label="Voice input"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 10v2a7 7 0 01-14 0v-2" />
                    <line stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="12" y1="19" x2="12" y2="22" />
                  </svg>
                </button>

                <button
                  data-chat-send
                  type="submit"
                  class="btn btn-primary btn-icon p-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled
                  aria-label="Send message"
                  aria-disabled="true"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                </button>
              </div>
            </div>

            <div id="chat-drop-zone" data-drop-zone class="drop-zone absolute inset-0 rounded-2xl border-2 border-dashed border-transparent bg-background-primary/50 transition-all duration-200 flex items-center justify-center pointer-events-none opacity-0">
              <div class="text-center px-4">
                <svg class="w-10 h-10 mx-auto mb-2 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <p class="text-sm font-medium text-text-secondary">Drop files here or click to upload</p>
                <p class="text-xs text-text-tertiary mt-1">PDF, DOC, DOCX, TXT, PNG, JPG, GIF, WEBP • Up to 10MB each</p>
              </div>
            </div>

            <input
              data-file-input
              type="file"
              accept=".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg,.gif,.webp"
              multiple
              class="sr-only"
              aria-hidden="true"
            />

            <p id="chat-hint" class="text-xs text-text-tertiary text-center">
              Press <kbd class="px-1.5 py-0.5 bg-background-tertiary rounded text-text-secondary font-mono text-xs">Enter</kbd> to send, <kbd class="px-1.5 py-0.5 bg-background-tertiary rounded text-text-secondary font-mono text-xs">Shift+Enter</kbd> for new line
            </p>
          </div>
        </form>
      </div>
    </div>

    <div class="mt-8 text-center animate-fade-in stagger-6">
      <p class="text-sm text-text-tertiary">
        No tracking • No ads • Your data stays private
        <a href="/privacy" class="ml-2 text-accent-primary hover:underline font-medium">Learn more</a>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  // Example chip handlers
  document.querySelectorAll('[data-example]').forEach(chip => {
    chip.addEventListener('click', () => {
      const textarea = document.querySelector('[data-chat-input]');
      const form = document.querySelector('[data-chat-form]');
      if (textarea && form) {
        textarea.value = chip.dataset.example;
        textarea.dispatchEvent(new Event('input'));
        textarea.focus();
        form.dispatchEvent(new Event('submit'));
      }
    });
  });
</script>

