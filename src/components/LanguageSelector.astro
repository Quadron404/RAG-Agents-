---
interface Props {
  currentLanguage: 'en' | 'fr' | 'es';
}

const { currentLanguage } = Astro.props;
---
<script is:inline>
  const select = document.querySelector('[data-language-select]');
  if (select) {
    const storageKey = 'govlink:language';

    const saved = localStorage.getItem(storageKey);
    if (saved && ['en', 'fr', 'es'].includes(saved)) {
      select.value = saved;
    }

    select.addEventListener('change', (e) => {
      const target = e.target;
      const lang = target.value;
      localStorage.setItem(storageKey, lang);
      window.location.reload();
    });
  }
</script>

<div class="relative" data-language-selector>
  <select
    data-language-select
    aria-label="Language"
    class="language-select appearance-none pr-10"
    value={currentLanguage}
  >
    <option value="en">English</option>
    <option value="fr">Français</option>
    <option value="es">Español</option>
  </select>

  <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none" aria-hidden="true">
    <svg class="w-4 h-4 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</div>

<style>
  .language-select {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-xl);
    min-width: 140px;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .language-select:hover {
    border-color: var(--color-border-secondary);
  }

  .language-select:focus {
    outline: none;
    border-color: var(--color-border-focus);
    box-shadow: var(--shadow-focus);
  }

  .language-select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 640px) {
    .language-select {
      min-width: 120px;
      padding: var(--space-1.5) var(--space-2.5);
    }
  }
</style>