# Named Cloudflare Tunnel configuration for the remote Computer.
#
# This file holds NO SECRETS and is safe to commit.  The credential is the
# tunnel token, which arrives as a Codespaces secret named CF_TUNNEL_TOKEN.
#
# Two ways to use it:
#   1. Export COMPUTER_HOSTNAME and let start-tunnel.sh generate this file.
#   2. Copy it to config.yml and edit the hostname yourself:
#        cp codespace/cloudflared/config.yml.example \
#           codespace/cloudflared/config.yml
#
# Do NOT use a quick tunnel (trycloudflare.com).  Those URLs are public, change
# on every restart, and cannot be placed behind Cloudflare Access -- which would
# mean the live screen of a real browser session is reachable by anyone.

tunnel: rag-agents-computer
credentials-file: /dev/null
no-autoupdate: true

# The app and the screen share one hostname on purpose.  Access gives the
# browser a first-party cookie for that hostname, so the noVNC WebSocket
# upgrade carries it with no CORS handling and no third-party-cookie gamble.
# Put the screen on a separate hostname and browsers will increasingly drop
# that cookie, bouncing the user back to the login screen mid-session.
#
# Rules are matched in order; the first hit on host AND path wins.
ingress:
  # 1) The live screen: RFB over WebSocket straight from websockify.
  #    websockify accepts the upgrade on any path; /websockify is just the
  #    stable name the RAG Agents UI connects to.
  - hostname: computer.example.com
    path: ^/websockify(/.*)?$
    service: http://127.0.0.1:6080
    originRequest:
      # Required for noVNC: without it Cloudflare buffers the upgrade
      # request and the screen hangs on "connecting" forever.
      noTLSVerify: true

  # 2) Everything else is the RAG Agents app.  Routing the app through the same
  #    hostname keeps the REST API and the /ws/screen relay behind Access too.
  - hostname: computer.example.com
    service: http://127.0.0.1:8000

  # 3) Never let an unknown hostname reach this machine.
  - service: http_status:404

# ---------------------------------------------------------------------------
# Cloudflare Access (configured in the dashboard, not here)
# ---------------------------------------------------------------------------
# In Zero Trust > Access > Applications, protect computer.example.com with a
# policy.  The screen shows a real logged-in browser on a real desktop, so treat
# it as the sensitive application it is:
#
#   * Who:     one or more named identities (email, email domain, or IdP group)
#   * How:     a second factor (OTP, or your IdP's own MFA)
#   * Session: short idle timeout, e.g. 30 minutes
#
# Test the policy from a private window before sharing the link.  A screen that
# is reachable without an Access login is a live view of a signed-in browser.
